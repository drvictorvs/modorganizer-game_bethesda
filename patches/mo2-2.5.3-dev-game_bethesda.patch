From 8f538c9720c527226bc0944d365f00460c5301db Mon Sep 17 00:00:00 2001
From: Victor <victor@localhost>
Date: Tue, 17 Nov 2026 17:05:11 -0300
Subject: [PATCH] Starfield: re-enable vanilla plugins after the game rewrites
 plugins.txt

---
 src/games/starfield/gamestarfield.cpp        | 12 +++-
 src/games/starfield/starfieldgameplugins.cpp | 70 +++++++++++++++++++-
 src/games/starfield/starfieldgameplugins.h   | 10 +++
 3 files changed, 88 insertions(+), 4 deletions(-)

diff --git a/src/games/starfield/gamestarfield.cpp b/src/games/starfield/gamestarfield.cpp
index 2e62cca..7e75ca3 100644
--- a/src/games/starfield/gamestarfield.cpp
+++ b/src/games/starfield/gamestarfield.cpp
@@ -123,12 +123,13 @@ QString GameStarfield::author() const
 
 QString GameStarfield::description() const
 {
-  return tr("Adds support for the game Starfield.");
+  return tr("Adds support for the game Starfield. Patched build: re-enables vanilla "
+            "plugins after Starfield rewrites plugins.txt.");
 }
 
 MOBase::VersionInfo GameStarfield::version() const
 {
-  return VersionInfo(1, 2, 0, VersionInfo::RELEASE_FINAL);
+  return VersionInfo(1, 2, 1, VersionInfo::RELEASE_FINAL);
 }
 
 QList<PluginSetting> GameStarfield::settings() const
@@ -140,7 +141,12 @@ QList<PluginSetting> GameStarfield::settings() const
                 true)
          << PluginSetting("enable_management_warnings",
                           tr("Show a warning when plugins.txt management is invalid."),
-                          true);
+                          true)
+         << PluginSetting(
+                "reenable_vanilla_plugins",
+                tr("Re-enable plugins from the game's Data folder after Starfield "
+                   "rewrites plugins.txt."),
+                true);
 }
 
 MappingType GameStarfield::mappings() const
diff --git a/src/games/starfield/starfieldgameplugins.cpp b/src/games/starfield/starfieldgameplugins.cpp
index 2126e89..ee9f4c1 100644
--- a/src/games/starfield/starfieldgameplugins.cpp
+++ b/src/games/starfield/starfieldgameplugins.cpp
@@ -1,8 +1,14 @@
 #include "starfieldgameplugins.h"
+#include <iplugingame.h>
 #include <ipluginlist.h>
+#include <iprofile.h>
 #include <report.h>
 #include <safewritefile.h>
 
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+
 using namespace MOBase;
 
 StarfieldGamePlugins::StarfieldGamePlugins(MOBase::IOrganizer* organizer)
@@ -96,7 +102,69 @@ QStringList StarfieldGamePlugins::readPluginList(MOBase::IPluginList* pluginList
 {
   if (m_Organizer->managedGame()->loadOrderMechanism() ==
       MOBase::IPluginGame::LoadOrderMechanism::PluginsTxt) {
-    return CreationGamePlugins::readPluginList(pluginList);
+    // Check the header before parsing: the base class only reads the file, but MO2
+    // rewrites it with its own header right after this refresh.
+    const bool rewrittenExternally = pluginsTxtRewrittenExternally();
+
+    QStringList loadOrder = CreationGamePlugins::readPluginList(pluginList);
+
+    if (rewrittenExternally &&
+        m_Organizer
+            ->pluginSetting(m_Organizer->managedGame()->name(),
+                            "reenable_vanilla_plugins")
+            .toBool()) {
+      reactivateVanillaPlugins(pluginList);
+    }
+
+    return loadOrder;
   }
   return {};
 }
+
+bool StarfieldGamePlugins::pluginsTxtRewrittenExternally() const
+{
+  QFile file(m_Organizer->profile()->absolutePath() + "/plugins.txt");
+  if (!file.open(QIODevice::ReadOnly) || file.size() == 0) {
+    // missing or empty: MO2 always writes at least its header
+    return true;
+  }
+
+  // MO2 always starts the file with this line (see writePluginList above); Starfield
+  // writes "# This file is used by Starfield to keep track of your downloaded
+  // content." instead.
+  const QByteArray firstLine = file.readLine().trimmed();
+  return !firstLine.startsWith(
+      "# This file was automatically generated by Mod Organizer.");
+}
+
+void StarfieldGamePlugins::reactivateVanillaPlugins(IPluginList* pluginList) const
+{
+  const IPluginGame* game = m_Organizer->managedGame();
+  const QDir vanillaData(game->gameDirectory().absoluteFilePath("Data"));
+  const QString blueprintPrefix = game->blueprintPrefix();
+
+  QStringList reactivated;
+  for (const QString& pluginName : pluginList->pluginNames()) {
+    if (pluginList->state(pluginName) != IPluginList::STATE_INACTIVE) {
+      continue;
+    }
+
+    // blueprint plugins are never written to plugins.txt; MO2 handles them itself
+    if (pluginList->isBlueprintFlagged(pluginName) ||
+        (!blueprintPrefix.isEmpty() &&
+         pluginName.startsWith(blueprintPrefix, Qt::CaseInsensitive))) {
+      continue;
+    }
+
+    if (QFileInfo::exists(vanillaData.absoluteFilePath(pluginName))) {
+      pluginList->setState(pluginName, IPluginList::STATE_ACTIVE);
+      reactivated.append(pluginName);
+    }
+  }
+
+  if (!reactivated.isEmpty()) {
+    qInfo("plugins.txt was rewritten outside Mod Organizer; re-enabled vanilla "
+          "plugins: %s",
+          qUtf8Printable(reactivated.join(", ")));
+  }
+}
diff --git a/src/games/starfield/starfieldgameplugins.h b/src/games/starfield/starfieldgameplugins.h
index a957b13..4c1eeb2 100644
--- a/src/games/starfield/starfieldgameplugins.h
+++ b/src/games/starfield/starfieldgameplugins.h
@@ -18,6 +18,16 @@ protected:
   virtual void writePluginList(const MOBase::IPluginList* pluginList,
                                const QString& filePath) override;
   virtual QStringList readPluginList(MOBase::IPluginList* pluginList) override;
+
+private:
+  // True when plugins.txt in the profile was last written by something other than
+  // MO2 -- in practice Starfield itself, which rewrites the file when a save is
+  // loaded or the Creations menu is opened and leaves core plugins unticked.
+  bool pluginsTxtRewrittenExternally() const;
+
+  // Ticks every plugin that ships in the game installation's Data folder
+  // (Starfield.esm, DLC, official BGS updates) if it is currently unticked.
+  void reactivateVanillaPlugins(MOBase::IPluginList* pluginList) const;
 };
 
 #endif  // _STARFIELDGAMEPLUGINS_H
-- 
2.43.0

